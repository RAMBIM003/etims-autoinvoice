(function () {
 const $ = id => document.getElementById(id);
 const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
 const money = v => Number(v || 0).toLocaleString('en-KE', {minimumFractionDigits:2, maximumFractionDigits:2});
 const show = (id, html) => { $(id).innerHTML = html; };

 const STAGE = {
  AWAITING_PAYMENT:['Awaiting payment','warn'], PAYMENT_RECEIVED:['Payment received','warn'],
  FISCALIZING:['Signing with KRA','warn'], RECEIPT_READY:['Receipt ready','ok'],
  FISCALIZATION_FAILED:['KRA signing failed','bad'], PAYMENT_MISMATCH:['Amount mismatch','bad'],
  CANCELLED:['Cancelled','bad']
 };

 async function call(path, o = {}) {
  const h = {...(o.headers || {})};
  if (localStorage.token) h.Authorization = 'Bearer ' + localStorage.token;
  if (o.body) h['Content-Type'] = 'application/json';
  let r;
  try { r = await fetch(API.BASE + path, {...o, headers: h}); }
  catch { throw new Error('Cannot reach the API. Start the backend with npm start.'); }
  const d = await r.json().catch(() => ({}));
  if (r.status === 401) { const e = new Error('Please sign in with a buyer account.'); e.auth = true; throw e; }
  if (!r.ok) throw new Error(d.error || 'Request failed (' + r.status + ')');
  return d;
 }

 async function loadLink() {
  const l = await call('/buyer-identity/mpesa');

  if (l.linked) {
   show('linkCard', `<h2>Your M-Pesa link</h2>
    <p>Name: <b>${esc(l.mpesa_name)}</b> &middot; phone ending <b>${esc(l.phone_last3)}</b></p>
    <p class="muted">Payments made from this name and number appear in your account. Unlinking affects new payments only.</p>
    <button class="btn out" id="unlink">Unlink M-Pesa</button>`);
   $('unlink').onclick = async () => {
    if (!confirm('Unlink your M-Pesa name? New payments will no longer appear here.')) return;
    await call('/buyer-identity/mpesa', {method: 'DELETE'});
    await refresh();
   };
  } else {
   show('linkCard', `<h2>Link your M-Pesa name</h2>
    <p class="muted">Enter your name exactly as it appears on M-Pesa. Payments from this name and your phone number will then appear here.</p>
    <input id="mname" type="text" placeholder="e.g. JOHN DOE">
    <button class="btn" id="linkBtn" style="margin-left:8px">Link</button>
    <label style="display:block;margin-top:12px;font-size:13px"><input type="checkbox" id="lc"> Payments made from my M-Pesa name and phone number may be linked to me, so that my receipts and purchases appear in my account. I can remove this link at any time.</label>
    <div id="linkMsg"></div>`);
   $('linkBtn').onclick = async () => {
    const name = $('mname').value.trim();
    if (name.split(/\s+/).filter(Boolean).length < 2) return show('linkMsg', '<div class="error">Enter your full name as it appears on M-Pesa.</div>');
    if (!$('lc').checked) return show('linkMsg', '<div class="error">Tick the consent box to link.</div>');
    try {
     await call('/buyer-identity/mpesa', {method: 'PUT', body: JSON.stringify({mpesa_name: name, consent: true})});
     await refresh();
    } catch (e) { show('linkMsg', `<div class="error">${esc(e.message)}</div>`); }
   };
  }
 }

 async function loadPurchases() {
  const d = await call('/buyer-app/orders');
  const orders = d.orders || [];

  if (!orders.length) {
   show('purchases', '<p class="muted">No purchases yet. Purchases appear here once a merchant payment is matched to your account.</p>');
   show('receipts', '<p class="muted">No receipts yet.</p>');
   return;
  }

  show('purchases', `<table><thead><tr><th>Date</th><th>Merchant</th><th>Reference</th><th>Total</th><th>Status</th></tr></thead><tbody>
   ${orders.map(o => {
    const [label, cls] = STAGE[o.stage] || [o.stage, ''];
    return `<tr>
     <td>${new Date(o.order.created_at).toLocaleDateString('en-KE')}</td>
     <td>${esc(o.order.merchant_name)}</td>
     <td class="mono">${esc(o.order.order_reference)}</td>
     <td>KES ${money(o.order.total_amount)}</td>
     <td><span class="pill ${cls}">${esc(label)}</span></td>
    </tr>`;
   }).join('')}
  </tbody></table>`);

  const ready = orders.filter(o => o.stage === 'RECEIPT_READY' && o.receipt_url && o.invoice);

  show('receipts', ready.length
   ? ready.map(o => `<div class="row">
      <div><b>${esc(o.order.merchant_name)}</b>
       <span class="muted">${esc(o.invoice.number)} &middot; KRA receipt ${esc(o.invoice.kra_receipt_number || '-')}</span>
       <div class="muted">KES ${money(o.order.total_amount)}</div>
       <div id="sm-${esc(o.invoice.id)}"></div></div>
      <div style="display:flex;gap:8px">
       <a class="btn out" href="${esc(o.receipt_url)}" target="_blank" rel="noopener">View / Download</a>
       <button class="btn" data-sms="${esc(o.invoice.id)}">Send to my phone</button>
      </div></div>`).join('')
   : '<p class="muted">No receipts yet. They appear once KRA has signed a purchase.</p>');
 }

 async function refresh() {
  await loadLink();
  await loadPurchases();
 }

 document.addEventListener('click', async e => {
  const b = e.target.closest('[data-sms]');
  if (!b) return;
  const id = b.dataset.sms;
  b.disabled = true;
  show('sm-' + id, '<span class="muted">Sending...</span>');
  try {
   const r = await call(`/buyer-app/receipts/${encodeURIComponent(id)}/sms`, {method: 'POST', body: '{}'});
   show('sm-' + id, `<span class="muted">Sent to ${esc(r.to || 'your phone')}.</span>`);
  } catch (x) {
   show('sm-' + id, `<div class="error">${esc(x.message)}</div>`);
  }
  b.disabled = false;
 });

 $('logout').onclick = () => { localStorage.removeItem('token'); location = 'log.html'; };

 (async function init() {
  if (!localStorage.token) {
   show('linkCard', '<p>Please <a href="log.html">sign in</a> or <a href="sign_buyer.html">register as a buyer</a>.</p>');
   return;
  }
  try {
   const p = await call('/buyer-app/profile');
   show('who', esc(p.name) + (p.pin_masked ? ' &middot; ' + esc(p.pin_masked) : ''));
   await refresh();
  } catch (e) {
   show('linkCard', `<div class="error">${esc(e.message)}</div>`);
   if (e.auth) localStorage.removeItem('token');
  }
 })();
})();