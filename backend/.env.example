PORT=5000
CORS_ORIGIN=http://127.0.0.1:5500
# Public HTTPS address of this API, used for Daraja callbacks (e.g. an ngrok URL)
PUBLIC_BASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=etims_db

# Generate each with the PowerShell command in the instructions (64 hex characters)
JWT_SECRET=
ENC_KEY=
HMAC_KEY=

# KRA GavaConnect PIN checker: PRODUCTION app credentials
KRA_CONSUMER_KEY=
KRA_CONSUMER_SECRET=
KRA_TOKEN_URL=https://api.kra.go.ke/v1/token/generate?grant_type=client_credentials
KRA_PIN_CHECK_URL=https://api.kra.go.ke/checker/v1/pinbypin

# KRA eTIMS OSCU: the Masterclass test taxpayer (never sent to the browser)
OSCU_BASE_URL=https://etims-api-sbx.kra.go.ke/etims-api
OSCU_CHECK_PATH=/selectCodeList
KRA_ENV=SANDBOX
KRA_PIN=
KRA_BRANCH_ID=00
KRA_DEVICE_SERIAL=
KRA_CMC_KEY=

# Daraja (use https://api.safaricom.co.ke and MPESA_ENV=production for live)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# OTP: leave SMS_PROVIDER empty and the code prints in this terminal
SMS_PROVIDER=
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
OTP_TTL_SECONDS=300
