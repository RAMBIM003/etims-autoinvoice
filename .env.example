CORS_ORIGIN=http://YOUR_SERVER_IP:8081

KRA_BASE_URL=https://sbx.kra.go.ke
KRA_CONSUMER_KEY=
KRA_CONSUMER_SECRET=
KRA_TOKEN_URL=https://sbx.kra.go.ke/v1/token/generate?grant_type=client_credentials
KRA_PIN_CHECK_URL=https://api.kra.go.ke/checker/v1/pinbypin

PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8081

# Reusing the existing mts-postgres container (alias "postgres" on the
# tender-scraper_default network) instead of running a new DB container.
DB_HOST=mts-postgres
DB_PORT=5432
DB_USER=etims_app
DB_PASSWORD=
DB_NAME=etims_db

JWT_SECRET=
ENC_KEY=
HMAC_KEY=

OSCU_BASE_URL=https://etims-api-sbx.kra.go.ke/etims-api
OSCU_CHECK_PATH=/selectCodeList
KRA_ENV=SANDBOX
KRA_PIN=
KRA_BRANCH_ID=01
KRA_DEVICE_SERIAL=

KRA_CMC_KEY=

MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

PAYMENT_SIMULATION=local

MPESA_CALLBACK_TOKEN=

SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
OTP_TTL_SECONDS=300
