const $=i=>document.getElementById(i),hide=(i,h)=>$(i).classList.toggle('hide',h),say=t=>$('msg').textContent=t||'';
const boxes=[...document.querySelectorAll('.otp input')],code=()=>boxes.map(b=>b.value).join('');
let kra=null,phoneVerified=false;
const refresh=()=>hide('sec',!(phoneVerified&&kra));
boxes.forEach((b,i)=>{b.oninput=()=>{b.value=b.value.replace(/\D/g,'');if(b.value&&boxes[i+1])boxes[i+1].focus()};
 b.onkeydown=e=>{if(e.key==='Backspace'&&!b.value&&boxes[i-1])boxes[i-1].focus()}});
const consented=()=>$('consent').checked||(say('Tick the consent box first.'),false);
const sendCode=async()=>{say();
 if(!consented())return;
 if(!API.phoneOk($('phone').value))return say('Enter a valid mobile number, e.g. 0712 345 678.');
 $('sendOtp').disabled=true;
 try{await API.post('/otp/send',{phone:$('phone').value,purpose:'SIGNUP_BUYER'});$('sentTo').textContent=$('phone').value;hide('otpBox',false);boxes[0].focus()}catch(e){say(e.message)}
 $('sendOtp').disabled=false};
$('sendOtp').onclick=sendCode;$('resend').onclick=e=>{e.preventDefault();sendCode()};
$('verify').onclick=async()=>{say();if(code().length<6)return say('Enter the 6-digit code.');
 try{await API.post('/otp/verify',{phone:$('phone').value,code:code(),purpose:'SIGNUP_BUYER'});
  phoneVerified=true;hide('otpBox',true);hide('sendOtp',true);hide('pOk',false);$('phone').readOnly=true;refresh()}catch(e){say(e.message)}};
$('pin').oninput=()=>$('connect').disabled=!/^[AP]\d{9}[A-Z]$/i.test($('pin').value.trim());
$('connect').onclick=async()=>{say();if(!consented())return;$('connect').disabled=true;
 try{const r=await API.post('/kra/validate-pin',{pin:$('pin').value.trim()});
  if(r.status!=='Active'){$('connect').disabled=false;return say(`This PIN is ${r.status}. Only an active PIN can be linked.`)}
  kra=r;['pin','name','type','status'].forEach(k=>$('k_'+k).textContent=r[k]);
  hide('kra',false);hide('connect',true);$('pin').readOnly=true;refresh()}catch(e){$('connect').disabled=false;say(e.message)}};
$('f').onsubmit=async e=>{e.preventDefault();
 if(!$('consent').checked)return say('Tick the consent box to continue.');
 if($('password').value.length<8)return say('Password must be at least 8 characters.');
 if($('password').value!==$('confirm').value)return say('Passwords do not match.');
 if(!$('email').checkValidity())return say('Enter a valid email address or leave it empty.');
 $('create').disabled=true;
 try{const r=await API.post('/buyer/register',{phone:$('phone').value,pin:kra.pin,consent:true,email:$('email').value.trim(),password:$('password').value});
  localStorage.token=r.token;location='buyer.html'}catch(x){say(x.message);$('create').disabled=false}};
